# Copie locale — cp .env.example .env puis adapter.
#
# DEV (sans AWS) : garder LOCAL_LOGS_DIR + ne pas definir ALERTS_SOURCE (defaut file).
# PROD (EC2)     : ALERTS_SOURCE=s3, pas de LOCAL_LOGS_DIR — voir /etc/clair-obscur/app.env (Terraform).

API_PORT=8020
LOCAL_LOGS_DIR=data/sample_logs
# ALERTS_SOURCE=file

# --- AWS (optionnel en local ; rempli par ./scripts/deploy-s3.sh) ---
# aws configure --profile clair-obscur  puis  ./scripts/deploy-s3.sh
AWS_PROFILE=clair-obscur
AWS_REGION=eu-west-3
AWS_DEFAULT_REGION=eu-west-3

# RAW_LOGS_BUCKET=clair-obscur-<account_id>-raw-logs
# RAW_LOGS_PREFIX=raw/opensearch/logs-raw/
# PREDICTIONS_BUCKET=clair-obscur-<account_id>-predictions
# PREDICTIONS_PREFIX=predictions/
# OUTPUT_BUCKET=clair-obscur-<account_id>-predictions
# OUTPUT_PREFIX=predictions/

# OUTPUT_BUCKET=clair-obscur-<account_id>-predictions
# OUTPUT_PREFIX=predictions/

# DYNAMODB_TABLE=clair-obscur-<account_id>-normalized-logs
# DYNAMODB_PK=RAW#clair-obscur-<account_id>-raw-logs#D#2026-01-12
# SQS_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/<account_id>/clair-obscur-<account_id>-predict
# SQS_VISIBILITY_TIMEOUT=900
# PREDICT_MODE=inline
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# (Opus : eu.anthropic.claude-opus-4-6-v1 — abonnement Marketplace requis)

# OpenSearch (onglet SIEM — repli démo si indisponible)
# OPENSEARCH_HOST=
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# Agentic (assistant IA — optionnel)
# OPENROUTER_API_KEY=
