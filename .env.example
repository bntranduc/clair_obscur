# =============================================================================
# CLAIR OBSCUR — configuration bootstrap (machine fraîche → prod AWS)
# =============================================================================
# 1. cp .env.example .env
# 2. Renseigner credentials AWS + GIT_REPO_URL
# 3. Console AWS → Bedrock → activer eu.anthropic.claude-sonnet-4-6 (eu-west-3)
# 4. chmod +x deploy-all.sh && ./deploy-all.sh
# =============================================================================

# --- AWS (obligatoire) ---
AWS_REGION=eu-west-3
AWS_DEFAULT_REGION=eu-west-3

# Option A : profil CLI (recommandé)
AWS_PROFILE=clair-obscur

# Option B : clés explicites (laisser AWS_PROFILE vide)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Dépôt cloné sur les EC2 (public ou token dans l'URL) ---
GIT_REPO_URL=https://github.com/bntranduc/clair_obscur.git
GIT_REF=main

# --- Bedrock ---
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# --- Types EC2 (optionnel) ---
# WORKER_INSTANCE_TYPE=t3.small
# APP_INSTANCE_TYPE=t2.medium
# DEMO_VM_INSTANCE_TYPE=t3.micro

# --- Ressources EC2 (1=oui, 0=non) ---
# ENABLE_EC2_WORKER=1
# ENABLE_EC2_APP=1
# ENABLE_EC2_DEMO_VM=1
# ENABLE_EC2_FRESH_VM=0

# --- Deploy (optionnel) ---
# INSTALL_UPLOAD_DEMO=1          # upload demo.jsonl après deploy (défaut: 1)
# INSTALL_GIT_PUSH=1             # git push avant deploy si commits locaux
# INSTALL_WAIT_TIMEOUT=2400      # timeout SSM/build (secondes)
# DEPLOY_OPENROUTER=auto         # auto|0|1 — pousse OpenRouter si clé présente
# DEPLOY_LOG_LLM=auto            # auto|0|1 — upload model_prod/ckpt.pt si présent
# OPENROUTER_KEY_FILE=openrout_key.txt

# =============================================================================
# Dev local uniquement — ignoré par ./deploy-all.sh
# =============================================================================
# LOCAL_LOGS_DIR=data/sample_logs
# ALERTS_SOURCE=file

# --- Rempli automatiquement par deploy-all.sh / terraform ---
# RAW_LOGS_BUCKET=
# PREDICTIONS_BUCKET=
# LOG_LLM_MODEL_S3_URI=
# DYNAMODB_TABLE=
# DYNAMODB_PK=
# DYNAMODB_ALERTS_TABLE=
# DYNAMODB_ALERTS_PK=ALERTS
# DYNAMODB_VMS_TABLE=
# ALERTS_SOURCE=dynamodb
# SQS_QUEUE_URL=
# OUTPUT_BUCKET=
# BEDROCK_MODEL_ID=...

# --- Optionnel (assistant IA OpenRouter) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
